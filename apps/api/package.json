{
  "name": "@montra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch --conditions=@montra/source src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:perf": "vitest run --mode perf",
    "start:worker": "node dist/worker-main.js",
    "dev:worker": "tsx watch --conditions=@montra/source src/worker-main.ts",
    "fx:load": "tsx --conditions=@montra/source src/fx-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1161.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@montra/ai-gateway": "workspace:*",
    "@montra/categorize": "workspace:*",
    "@montra/db": "workspace:*",
    "@montra/domain": "workspace:*",
    "@montra/i18n": "workspace:*",
    "@montra/importers": "workspace:*",
    "@montra/schemas": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@sentry/node": "^11.10.0",
    "fastify": "^5.12.7",
    "kysely": "^0.28.18",
    "nodemailer": "^8.0.11",
    "pdf-lib": "1.17.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@montra/sync": "workspace:*",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
