{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_URL", "NEXT_PUBLIC_*"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "DATABASE_ADMIN_URL", "API_DATABASE_URL", "API_DATABASE_ADMIN_URL"]
    }
  }
}
