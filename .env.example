# API
PORT=4000
DATABASE_URL=postgres://montra_app:montra_app@localhost:5432/montra
AUTH_MODE=dev
# Migrations (owner role)
DATABASE_ADMIN_URL=postgres://montra_owner:montra_owner@localhost:5432/montra
# Email: log | memory | smtp (docker compose Mailpit: smtp://localhost:1025)
MAIL_MODE=log
# MAIL_URL=smtp://localhost:1025
WEB_URL=http://localhost:3000
# FX rates (ECB needs no key). Optional second source for currencies ECB doesn't publish:
# OXR_APP_ID=
# Ory Kratos (AUTH_MODE=kratos). The API and the auth gateway reach Kratos directly; browsers and the phone use the
# gateway (`pnpm --filter @montra/api dev:auth-gateway`, AUTH-08, ADR-0042): NEXT_PUBLIC_KRATOS_URL and
# MONTRA_KRATOS_URL are http://localhost:4455.
# KRATOS_PUBLIC_URL=http://localhost:4433
# AUTH_GATEWAY_PORT=4455
# AUTH_GATEWAY_SECRET=change-me-at-least-32-characters-long
# KRATOS_WEBHOOK_SECRET=change-me-at-least-32-characters-long
