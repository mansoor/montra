{
  "name": "@montra/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed fetch client for the Montra API, shared by web and mobile.",
  "type": "module",
  "exports": {
    ".": {
      "@montra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@montra/schemas": "workspace:*",
    "zod": "^4.6.7"
  }
}
