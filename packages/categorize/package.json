{
  "name": "@montra/categorize",
  "version": "0.1.0",
  "private": true,
  "description": "Categorization pipeline: rules engine (RE2), payee history, transfer detection, learning, recurring detection, anomaly flags and quick-add parsing (AI-01..09, UP-02).",
  "type": "module",
  "exports": {
    ".": {
      "@montra/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:perf": "vitest run --mode perf"
  },
  "dependencies": {
    "@montra/domain": "workspace:*",
    "re2js": "^2.9.1"
  },
  "devDependencies": {
    "fast-check": "^4.10.2"
  }
}
