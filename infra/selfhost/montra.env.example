# Montra on your own server: the settings that aren't secret. Copy to .env next to compose.yaml and fill it in.
# Secrets don't go here: they are files in ./secrets (./setup.sh secrets). See docs/runbooks/selfhost-setup.md.

# --- Which release ---------------------------------------------------------------------------------------------------
# deploy.sh sets MONTRA_TAG on each release. MONTRA_ENVIRONMENT names the web image, which is built for this domain.
MONTRA_IMAGES=ghcr.io/mansoor/montra
MONTRA_TAG=
MONTRA_ENVIRONMENT=prod

# --- The way in ------------------------------------------------------------------------------------------------------
# At home: a Cloudflare Tunnel, no ports published (the default).
COMPOSE_PROFILES=tunnel
# On a VPS with its own address instead, use these two lines and drop `tunnel` above:
#   COMPOSE_FILE=compose.yaml:compose.direct.yaml
#   TRUSTED_PROXIES=<Cloudflare's IPv4 and IPv6 ranges, space-separated: https://www.cloudflare.com/ips/>

# --- Names -----------------------------------------------------------------------------------------------------------
# Three hostnames under one domain. COOKIE_DOMAIN is that domain: the session cookie and passkeys belong to it.
APP_HOST=app.example.com
API_HOST=api.example.com
AUTH_HOST=auth.example.com
COOKIE_DOMAIN=example.com

# --- Email (through a sending service over SMTP; a home connection can't deliver mail) --------------------------------
# The addresses must be on a domain with SPF, DKIM and DMARC set up at the sending service.
MAIL_FROM=Montra <no-reply@example.com>
KRATOS_FROM_ADDRESS=no-reply@example.com
SUPPORT_EMAIL=

# --- Files (an S3-compatible bucket at a provider, private, with a key scoped to it) ---------------------------------
# Backblaze B2: https://s3.<region>.backblazeb2.com and the bucket's region. Cloudflare R2:
# https://<account id>.r2.cloudflarestorage.com and S3_REGION=auto.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto

# --- Plans -----------------------------------------------------------------------------------------------------------
# off for family and friends: no Stripe, no plans enforced. `stripe` needs the Stripe secrets and price ids.
BILLING_MODE=off
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Key wrapping (docs/runbooks/key-wrapping.md) --------------------------------------------------------------------
# local: the master key in secrets/master_key. vault: Vault or OpenBao Transit; set VAULT_ADDR and mount a token file
# (see the runbook), then VAULT_TOKEN_FILE to where it's mounted.
KMS_MODE=local
VAULT_ADDR=
VAULT_TOKEN_FILE=
VAULT_TRANSIT_KEY=montra

# --- AI --------------------------------------------------------------------------------------------------------------
# anthropic with a key in secrets/anthropic_api_key. Without a key, categorizing falls back to rules and history.
AI_PROVIDER=anthropic
AI_LOCAL_DIRECT=false
